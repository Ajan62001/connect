# connect v0.2 — deployment environment (cp .env.example .env, then edit).
# Read by docker compose (variable interpolation + env_file for the backend
# containers). The no-docker dev flow keeps using backend/.env instead.
# Full knob list: backend/connect/orchestration/config.py (prefix CONNECT_).

# --- database -----------------------------------------------------------------
POSTGRES_PASSWORD=changeme
# In-compose DSN (service DNS "postgres"). Keep the password in sync with
# POSTGRES_PASSWORD above — or delete this line: compose then derives it
# from POSTGRES_PASSWORD automatically (see docker-compose.yml).
CONNECT_DATABASE_URL=postgresql://connect:changeme@postgres:5432/connect

# --- blobs --------------------------------------------------------------------
# container path of the shared content-addressed blob volume
CONNECT_BLOB_DIR=/data/blobs

# --- domain / ports -----------------------------------------------------------
# Empty = localhost (Caddy internal CA, self-signed https). Set a real
# domain on a VPS for automatic Let's Encrypt TLS.
CONNECT_DOMAIN=
# Host ports for the proxy. Defaults (8080/8443) dodge this machine's live
# services; a real VPS deployment MUST use 80/443 (ACME issuance):
#CONNECT_HTTP_PORT=80
#CONNECT_HTTPS_PORT=443
# Host loopback port of the dockerized Postgres (no-docker dev connects
# here; 5432 and 55432 are taken on this machine):
#CONNECT_PG_HOST_PORT=55433

# --- provider keys ------------------------------------------------------------
ANTHROPIC_API_KEY=
# Web search for investigations + analysis verification. With a Tavily key we
# use it; WITHOUT one we fall back to the keyless DuckDuckGo backend, so web
# search works out of the box. Set CONNECT_WEB_SEARCH_ENABLED=false to force
# corpus-only (no outbound search), e.g. air-gapped deployments.
TAVILY_API_KEY=
#CONNECT_WEB_SEARCH_ENABLED=true
TWITTERAPI_IO_API_KEY=

# --- Instagram direct posting (optional) --------------------------------------
# When all three are set, the social-post feature offers "Post to Instagram"
# (via the Graph API); otherwise it falls back to manual download. Needs an
# Instagram Business/Creator account + a long-lived Graph API token. The public
# base URL is THIS backend's public origin — Instagram fetches the rendered
# card from {CONNECT_PUBLIC_BASE_URL}/api/social/card/<id>.jpg, so it must be
# publicly reachable (localhost cannot publish).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
#CONNECT_PUBLIC_BASE_URL=https://connect.example.com

# --- Instagram Reels narration (optional) -------------------------------------
# Reels (ig_reel) always render via ffmpeg; narration is added when a TTS engine
# is available. CONNECT_REEL_TTS_ENGINE: auto (default) | elevenlabs | piper | none.
# 'auto' prefers ElevenLabs (if a key is set) then local Piper, else silent.
#
# ElevenLabs (cloud, most natural — recommended):
#ELEVENLABS_API_KEY=sk_...
#CONNECT_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # 'George' (warm storyteller)
#CONNECT_ELEVENLABS_MODEL=eleven_multilingual_v2
#
# Local Piper (free, offline fallback): install pip install '.[tts]', download a
# voice (python -m piper.download_voices en_US-ryan-high --download-dir DIR),
# then point this at DIR. The Docker image bakes a voice at /opt/piper.
#CONNECT_PIPER_VOICE_DIR=/path/to/piper/voices
#CONNECT_PIPER_VOICE=en_US-ryan-high

# --- Instagram Reels b-roll: photos + VIDEO (optional) ------------------------
# A free Pexels key (https://www.pexels.com/api/) powers BOTH stock photos and
# stock VIDEO b-roll. With a key, each scene uses a relevant short clip (real
# footage); without it, reels fall back to keyless Openverse photos, then a
# themed colour. CONNECT_REEL_USE_VIDEO toggles video globally (default true).
# CONNECT_REEL_CAPTION_STYLE: karaoke (default) | lower_third | centered | boxed.
#PEXELS_API_KEY=...
#CONNECT_REEL_USE_VIDEO=true
#CONNECT_REEL_CAPTION_STYLE=karaoke

# --- AI presenter: HeyGen avatar for reels (optional, paid) -------------------
# When configured AND a reel renders in presenter mode, a photoreal talking-head
# clip of the narration is generated via HeyGen and composited over the b-roll
# (the avatar speaks with HeyGen's OWN voice, not ElevenLabs). Unset => presenter
# mode falls back to the local TTS slideshow. List avatars/voices and render a
# test clip with: python -m scripts.heygen_experiment (from backend/).
#HEYGEN_API_KEY=...
#CONNECT_HEYGEN_AVATAR_ID=...            # GET /v2/avatars (or run the script)
#CONNECT_HEYGEN_VOICE_ID=...             # GET /v2/voices  (optional)
#CONNECT_HEYGEN_AVATAR_STYLE=normal      # normal | circle | closeUp
#CONNECT_REEL_PRESENTER=off              # off | pip | full
# Avatar voice: 'elevenlabs' (default) lip-syncs the avatar to your ElevenLabs
# brand voice; 'heygen' uses HeyGen's own TTS (CONNECT_HEYGEN_VOICE_ID).
#CONNECT_HEYGEN_VOICE_SOURCE=elevenlabs  # elevenlabs | heygen

# --- content pipeline: X + LinkedIn publishing (optional, SCAFFOLDED) ---------
# Campaigns generate, queue and schedule X threads / LinkedIn posts regardless;
# these creds enable the final hop to those networks. Unset => the platform
# reports "not connected" and a scheduled item for it lands in 'failed' with an
# actionable error (Instagram card/carousel publishing is fully live above).
X_API_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# --- content pipeline: Zapier publishing (optional) ---------------------------
# A Zapier "Catch Hook" URL. When set, the review queue shows "Send to Zapier"
# per draft: publishing POSTs a JSON payload (format, platform, caption,
# hashtags, public media URLs) to this webhook, so a Zap can post it to any
# network Zapier supports — no per-platform API creds needed. Media formats
# (card/carousel/reel) still need CONNECT_PUBLIC_BASE_URL so the destination can
# fetch the rendered media.
#CONNECT_ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/0000000/xxxxxxx

# --- auth (tenancy design §3 — Phase B, live) ----------------------------------
# Google OAuth client credentials (Google Cloud Console; setup steps + the
# exact redirect URIs to register: README "Authentication"). Leave empty to
# run without Google sign-in — then enable the dev hatch below or nobody
# can sign in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Signs the short-lived OAuth handshake cookie (the app session itself is a
# server-side row, not a signed token). Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty => ephemeral per-process secret (logins in-flight across a restart
# fail; uvicorn --workers 2 may bounce a handshake between secrets) — set it.
CONNECT_SESSION_SECRET=
# Bootstrap override: comma-separated emails that may always sign in and
# are created as admins (the FIRST user to ever sign in becomes admin
# automatically; this is for recovery/bootstrap beyond that):
#CONNECT_ADMIN_EMAILS=you@example.com
# DEV-ONLY login escape hatch: when set, POST /api/auth/dev-login signs in
# as exactly this email WITHOUT Google (the signin page shows the button).
# Lets you run + verify the system before Google credentials exist.
# NEVER set this on a production/VPS deployment:
#CONNECT_DEV_LOGIN_EMAIL=dev@example.com
# Browser origins allowed by the CSRF Origin check beyond same-origin.
# Defaults cover the split-port dev flow (http://localhost:3000,
# http://127.0.0.1:3000); add your LAN origin when serving dev over LAN:
#CONNECT_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.20:3000
# Split-port dev only (frontend :3000 / api :8001): where the OAuth
# callback should land the browser, and the exact redirect URI registered
# in Google Console. Leave both empty for the docker/Caddy topology:
#CONNECT_FRONTEND_ORIGIN=http://localhost:3000
#CONNECT_OAUTH_REDIRECT_URI=http://localhost:8001/api/auth/callback

# --- LLM budgets (locked user decisions) ---------------------------------------
# Admin/general per-day defaults (the admin keeps $2 general / $10
# investigation):
CONNECT_DAILY_LLM_BUDGET_USD=2.0
CONNECT_INVESTIGATION_DAILY_BUDGET_USD=10.0
# Deployment-wide daily backstop across ALL users + system jobs — this is
# the hard cap on the actual Anthropic bill (locked: $10/day):
CONNECT_GLOBAL_DAILY_BUDGET_USD=10.0
# Member per-user defaults (locked: $0.50 general / $2 investigation).
# These are SEEDS for the admin-editable app_setting rows — once an admin
# edits them in the UI, app_setting wins and these envs are fallbacks only:
CONNECT_MEMBER_DAILY_BUDGET_USD=0.50
CONNECT_MEMBER_INVESTIGATION_DAILY_BUDGET_USD=2.0

# --- runtime knobs ------------------------------------------------------------
# per-worker cap on concurrent Anthropic calls (cluster ceiling = workers x this)
CONNECT_LLM_MAX_CONCURRENT=4
# UTC hour for the nightly enrich batch + brief pre-generation
CONNECT_NIGHTLY_SWEEP_UTC_HOUR=21
# interactive backpressure -> 429 with Retry-After (per-user in-flight cap
# on analyses/investigations + global interactive queue depth)
CONNECT_USER_MAX_INTERACTIVE=2
CONNECT_INTERACTIVE_QUEUE_LIMIT=20
# per-user API rate limits (in-memory moving windows, per process; SSE
# exempt; the PG-backed budget governors remain the hard cost backstop)
#CONNECT_RATE_LIMIT_ENABLED=true
#CONNECT_RATE_LIMIT_READ_PER_MINUTE=120
#CONNECT_RATE_LIMIT_INGEST_PER_MINUTE=10
#CONNECT_RATE_LIMIT_CREATE_PER_MINUTE=5
# background polling of the source registry (beat schedules, workers run)
CONNECT_POLLER_ENABLED=true
# local fastembed embeddings + pgvector index (model is baked in the image)
CONNECT_EMBEDDINGS_ENABLED=true
