# Claim-decomposition cases: input text + property bounds (graded
# deterministically) + a judge rubric (atomicity/kind/checkable-honesty).
# expect_uncheckable=true means the input contains a normative or predictive
# claim that must NOT be forced into a checkable factual claim.
{"input_text": "The Pradhan Mantri Awas Yojana aims to provide affordable housing to the urban poor. As of 2024 the scheme had sanctioned over one crore houses, and the government extended its deadline to December 2025.", "expected_kind": "policy", "min_claims": 2, "max_claims": 5, "expect_uncheckable": false, "note": "policy with multiple factual claims"}
{"input_text": "The company reported that its net profit doubled to 500 crore rupees in the latest quarter, driven by higher lending margins. The chairman said the bank should prioritise rural expansion over urban branches.", "expected_kind": "finance_claim", "min_claims": 2, "max_claims": 4, "expect_uncheckable": true, "note": "a factual profit claim plus a normative 'should' opinion"}
{"input_text": "The opposition alliance won the state assembly election, securing 140 of 230 seats. The chief minister resigned the next morning and the alliance leader was sworn in within 48 hours.", "expected_kind": "political_event", "min_claims": 2, "max_claims": 5, "expect_uncheckable": false, "note": "political event, several checkable facts"}
{"input_text": "Analysts predict that India's GDP will grow faster than 8 percent next year if monsoon rains are normal. They argue the government ought to cut corporate taxes to sustain the momentum.", "expected_kind": "other", "min_claims": 1, "max_claims": 4, "expect_uncheckable": true, "note": "predictive forecast + normative 'ought' — both uncheckable"}
{"input_text": "A viral message claims that the new toll on the expressway was scrapped from this month. Officials have neither confirmed nor denied the change, and toll booths were still operating yesterday.", "expected_kind": "news_claim", "min_claims": 1, "max_claims": 4, "expect_uncheckable": false, "note": "news claim with a checkable factual core"}
{"input_text": "The central bank raised the repo rate by 25 basis points to curb inflation, and the finance secretary stated that fuel subsidies caused the fiscal slippage last year.", "expected_kind": "finance_claim", "min_claims": 2, "max_claims": 4, "expect_uncheckable": false, "note": "a factual rate hike plus a causal claim"}
