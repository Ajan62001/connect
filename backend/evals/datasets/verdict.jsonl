# End-to-end verdict cases: claim + a fixed mini-corpus -> gold verdict.
# Each doc has a credibility_tier (1 best .. 4 worst) and a domain (publisher
# key for the independence discount). Cases are designed so that correct stance
# classification yields the gold verdict under the deterministic weighting math.
{"claim": "The Reserve Bank of India kept the repo rate unchanged at 6.5 percent in February 2025.", "docs": [{"title": "RBI policy review", "text": "The Monetary Policy Committee kept the repo rate unchanged at 6.5 percent in February 2025, the central bank announced.", "credibility_tier": 1, "domain": "rbi.org.in"}, {"title": "Markets react to RBI", "text": "Bond yields were steady after the RBI held the repo rate at 6.5 percent, a decision widely expected by economists.", "credibility_tier": 2, "domain": "livemint.com"}], "gold": "supported", "note": "two independent affirming sources"}
{"claim": "Retail inflation in India rose above 7 percent in January 2025.", "docs": [{"title": "CPI data release", "text": "Retail inflation eased to 3.8 percent in January 2025, well below the 7 percent mark and inside the central bank target band.", "credibility_tier": 1, "domain": "mospi.gov.in"}, {"title": "Inflation cools", "text": "Consumer price inflation came in at 3.8 percent for January 2025, far from any seven percent reading, statisticians confirmed.", "credibility_tier": 2, "domain": "thehindu.com"}], "gold": "refuted", "note": "two sources contradict the claim"}
{"claim": "The new labour code improved worker protections without raising compliance costs for firms.", "docs": [{"title": "Labour code explainer", "text": "The new labour code strengthened worker protections by mandating timely wage payment and broader social security coverage.", "credibility_tier": 1, "domain": "prsindia.org"}, {"title": "Industry pushes back", "text": "Industry bodies warned that the new labour code sharply raised compliance costs for firms, citing extra filings and audits.", "credibility_tier": 1, "domain": "business-standard.com"}], "gold": "mixed", "note": "one supports, one refutes, equal weight"}
{"claim": "The municipal corporation completed the metro line extension on schedule in 2025.", "docs": [{"title": "Local blog roundup", "text": "An unverified neighbourhood blog claimed the metro line extension opened on time in 2025, though officials did not confirm a date.", "credibility_tier": 4, "domain": "randomblog.example"}], "gold": "unverified", "note": "single low-credibility source, total weight below threshold"}
{"claim": "India's goods exports grew in the 2024-25 financial year compared with the previous year.", "docs": [{"title": "Trade ministry data", "text": "Merchandise exports grew 5 percent in 2024-25 over the previous financial year, the commerce ministry reported.", "credibility_tier": 1, "domain": "commerce.gov.in"}, {"title": "Exporters welcome growth", "text": "Exporter associations said goods exports rose in 2024-25 versus the year before, helped by engineering shipments.", "credibility_tier": 2, "domain": "economictimes.com"}, {"title": "Analysts note uptick", "text": "Analysts confirmed that India's goods exports increased in 2024-25 compared with the prior year despite global headwinds.", "credibility_tier": 2, "domain": "reuters.com"}], "gold": "supported", "note": "three independent affirming sources"}
{"claim": "The state government privatised the public electricity distribution utility in 2025.", "docs": [{"title": "Power department statement", "text": "The state government said the public electricity distribution utility remained fully state-owned in 2025 and was not privatised.", "credibility_tier": 1, "domain": "gov.in"}, {"title": "No sale, says minister", "text": "The power minister rejected reports of privatisation, stating the distribution utility stayed under government control through 2025.", "credibility_tier": 2, "domain": "thehindu.com"}], "gold": "refuted", "note": "both sources deny the claim"}
